PAPERLESS_AI_INITIAL_SETUP=yes
# Optional: comma-separated list of origins allowed to make cross-origin
# browser requests to this app's API (e.g. https://my-frontend.example).
# Leave unset for same-origin only (recommended default).
ALLOWED_ORIGINS=
# Set to "yes" once this app is served over HTTPS (directly or via a
# TLS-terminating reverse proxy) to mark the session cookie Secure.
COOKIE_SECURE=no
PAPERLESS_API_URL=http://localhost:8000/api
PAPERLESS_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
PAPERLESS_USERNAME=clusterzx
AI_PROVIDER=custom
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Sampling temperature for Ollama classification, 0-1 (default: 0, deterministic)
OLLAMA_TEMPERATURE=0
# Fixed seed for Ollama sampling to keep results reproducible (default: 42)
OLLAMA_SEED=42
# Max tokens Ollama may generate per response (default: 512)
OLLAMA_NUM_PREDICT=512
# Upper bound for Ollama's context window (num_ctx) in tokens (default: 8192)
OLLAMA_NUM_CTX_MAX=8192
SCAN_INTERVAL=*/30 * * * *
SYSTEM_PROMPT=`You are a personalized document analyzer. Your task is to analyze documents and extract relevant information.\n\nAnalyze the document content and extract the following information into a structured JSON object:\n\n1. title: Create a concise, meaningful title for the document\n2. correspondent: Identify the sender/institution but do not include addresses\n3. tags: Select up to 4 relevant thematic tags\n4. document_date: Extract the document date (format: YYYY-MM-DD)\n5. language: Determine the document language (e.g. "de" or "en")\n      \nImportant rules for the analysis:\n\nFor tags:\n- FIRST check the existing tags before suggesting new ones\n- Use only relevant categories\n- Maximum 4 tags per document, less if sufficient (at least 1)\n- Avoid generic or too specific tags\n- Use only the most important information for tag creation\n- The output language is the one used in the document! IMPORTANT!\n\nFor the title:\n- Short and concise, NO ADDRESSES\n- Contains the most important identification features\n- For invoices/orders, mention invoice/order number if available\n- The output language is the one used in the document! IMPORTANT!\n\nFor the correspondent:\n- Identify the sender or institution\n  When generating the correspondent, always create the shortest possible form of the company name (e.g. "Amazon" instead of "Amazon EU SARL, German branch")\n\nFor the document date:\n- Extract the date of the document\n- Use the format YYYY-MM-DD\n- If multiple dates are present, use the most relevant one\n\nFor the language:\n- Determine the document language\n- Use language codes like "de" for German or "en" for English\n- If the language is not clear, use "und" as a placeholder
`
PROCESS_PREDEFINED_DOCUMENTS=yes
TAGS=pre-process
ADD_AI_PROCESSED_TAG=no
AI_PROCESSED_TAG_NAME=ai-processed
USE_PROMPT_TAGS=no
PROMPT_TAGS=
USE_EXISTING_DATA=no
API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CUSTOM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_MODEL=deepseek-chat
# Enables the EntityResolver (fuzzy-matches tags/correspondents/document types
# against existing entities instead of always creating new ones). Disabled by
# default (default: no).
ENTITY_RESOLVER_ENABLED=no
# Similarity score (0-1) at/above which a candidate is auto-mapped without asking
# an LLM judge (default: 0.90). Normally tuned via scripts/tune-thresholds.js.
ENTITY_RESOLVER_AUTO_THRESHOLD=0.90
# Minimum similarity score (0-1) to even consult the LLM judge below the auto
# threshold (default: 0.65). Normally tuned via scripts/tune-thresholds.js.
ENTITY_RESOLVER_JUDGE_MIN=0.65
# Path to the SQLite database storing entity aliases and the review queue
# (default: data/entities.db). Usually left at the default.
ENTITY_RESOLVER_DB_PATH=data/entities.db
# Enables the second, semantic similarity channel via Ollama text embeddings
# (model bge-m3) alongside the trigram channel above - catches orthographically
# distant synonyms trigram similarity structurally cannot see (e.g. German
# Entgeltabrechnung/Verdienstbescheinigung, or cross-lingual
# Entgeltabrechnung/Payroll Statement). Disabled by default (default: no).
# Requires "ollama pull bge-m3" on the Ollama instance before enabling.
EMBEDDING_SIMILARITY_ENABLED=no
# Ollama embedding model to use (default: bge-m3). Must be pulled on the
# Ollama instance first.
EMBEDDING_MODEL=bge-m3
# Cosine-similarity score (0-1) at/above which a candidate is auto-mapped via
# the embedding channel without asking an LLM judge (default: 0.90). Normally
# tuned via scripts/tune-thresholds.js.
EMBED_AUTO_THRESHOLD=0.90
# Minimum cosine-similarity score (0-1) to consult the LLM judge via the
# embedding channel (default: 0.65). Normally tuned via scripts/tune-thresholds.js.
EMBED_JUDGE_MIN=0.65
# Comma-separated entity types to skip the embedding channel for (default: none).
# Some types (e.g. tags) are naturally semantically clustered, so the same
# threshold that works for document types/correspondents mostly flags topically
# related-but-distinct entities there instead of real duplicates. Example:
# EMBEDDING_EXCLUDED_TYPES=tag
EMBEDDING_EXCLUDED_TYPES=
# Enables the Document Fingerprint feature: recognizes recurring documents from
# the same correspondent via content-embedding similarity (reusing the channel
# above) and reuses their already-confirmed tags/document type instead of
# trusting a fresh LLM classification. Disabled by default (default: no).
# Requires the embedding model from EMBEDDING_MODEL to be reachable.
DOCUMENT_FINGERPRINT_ENABLED=no
# Cosine-similarity score (0-1) at/above which a recurring document's tags/
# document type are reused silently, with no LLM judge or review queue
# (default: 0.90, unmeasured placeholder). Needs its own tuning measurement
# against labelled document pairs before production activation - see
# docs/superpowers/specs/2026-08-02-phase5-fingerprint-design.md.
FINGERPRINT_SIMILARITY_THRESHOLD=0.90
